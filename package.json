{
  "name": "moe-memory-battle",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node ./dist/server/index.js",
    "serve": "npx ng serve",
    "build": "npm run build-client && npm run build-common && npm run build-server",
    "build:prod": "npm run build-client:prod && npm run build-common && npm run build-server",
    "build-client": "rimraf ./dist/client/* && ng build",
    "build-client:prod": "rimraf ./dist/client/* && ng build --configuration=production",
    "build-common": "rimraf ./dist/common/* && tspc --p ./tsconfig.common.json",
    "build-server": "rimraf ./dist/server/* && webpack -c ./webpack.config.ts",
    "package": "rimraf ./release/* && pkg . --options max_old_space_size=4096 --output ./release/mmb-debug.exe && create-nodew-exe ./release/mmb-debug.exe ./release/mmb.exe",
    "release": "npm run build:prod && npm run sea",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test-client",
    "test-client": "jest --config=src/client/jest.config.ts",
    "lint": "npx eslint ./src",
    "sea": "rimraf ./release/* && node --experimental-sea-config ./sea-config.json && node -e \"require('fs').copyFileSync(process.execPath, './release/mmb.exe')\" && npx postject ./release/mmb.exe NODE_SEA_BLOB ./dist/mmb.blob --sentinel-fuse NODE_SEA_FUSE_fce680ab2cc467b6e072b8b5df1996b2 && npx copyfiles -f src/mmb.vbs release"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.5",
    "@angular/cdk": "^19.0.4",
    "@angular/common": "^19.0.5",
    "@angular/compiler": "^19.0.5",
    "@angular/core": "^19.0.5",
    "@angular/forms": "^19.0.5",
    "@angular/material": "^19.0.4",
    "@angular/platform-browser": "^19.0.5",
    "@angular/platform-browser-dynamic": "^19.0.5",
    "@angular/router": "^19.0.5",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/ws": "^8.5.2",
    "cors": "^2.8.5",
    "cpr": "^3.0.1",
    "express": "^4.17.3",
    "extract-zip": "^2.0.1",
    "got": "^11.8.3",
    "ionicons": "^4.6.3",
    "mkdirp": "^1.0.4",
    "postcss": "^8.5.3",
    "promisepipe": "^3.0.0",
    "rxjs": "^7.8.1",
    "set-cookie-parser": "^2.4.8",
    "tailwindcss": "^4.0.15",
    "tslib": "^2.2.0",
    "ws": "^8.5.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.6",
    "@angular/cli": "^19.0.6",
    "@angular/compiler-cli": "^19.0.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.14",
    "@types/mkdirp": "^1.0.2",
    "@types/proxy-from-env": "^1.0.1",
    "@types/set-cookie-parser": "^2.4.2",
    "@yao-pkg/pkg": "^6.1.1",
    "angular-eslint": "19.0.2",
    "copyfiles": "^2.4.1",
    "create-nodew-exe": "^1.0.10",
    "eslint": "^9.16.0",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.4.2",
    "postject": "^1.0.0-alpha.6",
    "rimraf": "^3.0.2",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-patch": "^3.3.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.0",
    "typescript-transform-paths": "^3.5.2",
    "webpack-cli": "^6.0.1"
  },
  "pkg": {
    "assets": [
      "./dist/**/*"
    ],
    "targets": [
      "node16-win-x64"
    ]
  },
  "bin": "./dist/server/index.js"
}
